# Local development (app on host, DB in Docker)
DATABASE_URL=postgres://uptime:uptime@localhost:5432/uptime

# Docker Compose full stack uses timescaledb as the DB host instead:
# DATABASE_URL=postgres://uptime:uptime@timescaledb:5432/uptime

PORT=3000
PING_INTERVAL_MS=60000
LOGIN_USER=admin
LOGIN_PASSWORD=haifa

# Match kickoff labels (fixtures + league table "next" column). Default: America/New_York (US Eastern).
# DISPLAY_TZ=Asia/Jerusalem

# Docker + corporate SSL inspection (Zscaler, etc.):
# 1. Export your root CA: ./scripts/export-extra-ca-macos.sh
# 2. Set TLS_INSECURE=0 and NODE_EXTRA_CA_CERTS=/certs/extra-ca.pem in .env
# Or leave TLS_INSECURE=1 (default in docker-compose) to skip verification in dev.
TLS_INSECURE=1
# NODE_EXTRA_CA_CERTS=/certs/extra-ca.pem
